<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Students | Greenwood High</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <a class="brand" href="/dashboard">
          <span class="brand-mark">C</span>
          <span class="brand-name">classroom<span class="brand-dot">.</span></span>
        </a>

        <div class="school-switcher">
          <span class="school-avatar">GH</span>
          <span class="school-label">
            <strong>Greenwood High</strong>
            <small>School workspace</small>
          </span>
        </div>

        <p class="nav-caption">MANAGE</p>
        <nav class="main-nav">
          <a class="nav-link" href="/dashboard"><span class="nav-icon">▦</span>Overview</a>
          <a class="nav-link active" href="/students"><span class="nav-icon">♙</span>Students</a>
          <a class="nav-link" href="/results"><span class="nav-icon">▤</span>Results</a>
          <a class="nav-link" href="/reports"><span class="nav-icon">▧</span>Reports</a>
          <a class="nav-link" href="/logout"><span class="nav-icon">↩</span>Logout</a>
        </nav>
      </aside>

      <main class="main-content dashboard-page">
        <header class="topbar">
          <div class="breadcrumbs">
            <span>Greenwood High</span>
            <span class="crumb-slash">/</span>
            <strong>Students</strong>
          </div>
          <div class="topbar-actions">
            <span class="term-pill"><span class="status-dot"></span> School records</span>
          </div>
        </header>

        <section class="page-heading">
          <div>
            <p class="eyebrow">STUDENT DIRECTORY</p>
            <h1>Students</h1>
          </div>
        </section>

        <% if (message) { %>
          <div class="error-box"><%= message %></div>
        <% } %>

        <div class="panel form-panel">
          <h2>Add student</h2>
          <form method="POST" action="/students" class="inline-form">
            <input type="text" name="student_id" placeholder="Student ID" required />
            <input type="text" name="first_name" placeholder="First name" required />
            <input type="text" name="last_name" placeholder="Last name" required />
            <select name="gender" required>
              <option value="">Gender</option>
              <option value="Female">Female</option>
              <option value="Male">Male</option>
              <option value="Other">Other</option>
            </select>
            <select name="class_id" required>
              <option value="">Class</option>
              <% classes.forEach((classItem) => { %>
                <option value="<%= classItem.id %>"><%= classItem.name %></option>
              <% }) %>
            </select>
            <button type="submit" class="button button-primary">Save student</button>
          </form>
        </div>

        <article class="panel table-panel">
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Student ID</th>
                  <th>Name</th>
                  <th>Gender</th>
                  <th>Class</th>
                  <th>Results</th>
                  <th>Average</th>
                </tr>
              </thead>
              <tbody>
                <% students.forEach((student) => { %>
                  <tr>
                    <td><%= student.student_id %></td>
                    <td><%= student.first_name %> <%= student.last_name %></td>
                    <td><%= student.gender %></td>
                    <td><%= student.class_name %></td>
                    <td><%= student.result_count %></td>
                    <td><%= student.average_score %>%</td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </article>
      </main>
    </div>
  </body>
</html>
